# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Backend API base URL
VITE_API_URL=http://localhost:4000/api/v1

# Your SaaS domain (used to build subdomain URLs)
VITE_APP_DOMAIN=clinicpos.com

# Local dev only — tells the backend which tenant to load (subdomain of test clinic)
# Remove this in production (subdomain is read from the URL automatically)
VITE_TENANT_SUBDOMAIN=demo
