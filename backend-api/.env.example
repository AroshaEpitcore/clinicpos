# Copy this file to .env and fill in your values
# NEVER commit .env to git

# PostgreSQL
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/clinicpos_db

# JWT
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=8h

# Server
PORT=4000
NODE_ENV=development

# Super admin credentials (for admin-frontend login)
ADMIN_EMAIL=admin@healthcenter.lk
ADMIN_PASSWORD=replace_with_secure_password
# Optional: separate JWT secret for super admin tokens (falls back to JWT_SECRET if not set)
ADMIN_JWT_SECRET=replace_with_another_long_random_secret

# File upload (local storage path)
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=2

# Redis (optional — for session blacklist)
REDIS_URL=redis://localhost:6379
